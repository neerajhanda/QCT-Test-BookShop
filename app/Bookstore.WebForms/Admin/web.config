<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- Require authentication for all admin pages -->
    <authorization>
      <deny users="?" />
      <allow roles="Administrators" />
      <deny users="*" />
    </authorization>
    
    <!-- Admin-specific settings -->
    <httpRuntime maxRequestLength="51200" executionTimeout="300" />
    
    <!-- Disable caching for admin pages to ensure fresh data -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    
    <!-- Custom error handling for admin area -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx">
      <error statusCode="403" redirect="~/Unauthorized.aspx" />
      <error statusCode="404" redirect="~/NotFound.aspx" />
    </customErrors>
  </system.web>
  
  <!-- Prevent direct access to admin configuration files -->
  <location path="web.config">
    <system.web>
      <authorization>
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>