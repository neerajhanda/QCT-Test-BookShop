<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Bookstore.WebForms.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <asp:ContentPlaceHolder ID="TitleContent" runat="server">
            Bob's Used Books
        </asp:ContentPlaceHolder>
    </title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/Content/css/site.css" />
    <link rel="stylesheet" href="~/Content/css/styles.css" />
    <link rel="stylesheet" href="~/Content/css/custom-style.css" />
    
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server">
        </asp:ScriptManager>
        
        <!-- Navigation Header -->
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <asp:HyperLink ID="BrandLink" runat="server" NavigateUrl="~/Default.aspx" CssClass="navbar-brand" Text="Bob's Used Books" />

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportContent" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
                        <ul class="navbar-nav flex-grow-1">
                            <asp:PlaceHolder ID="AuthenticatedNavigation" runat="server" Visible="false">
                                <li class="nav-item">
                                    <asp:HyperLink ID="OrdersLink" runat="server" NavigateUrl="~/Orders.aspx" CssClass="nav-link text-dark" Text="My Orders" />
                                </li>
                            </asp:PlaceHolder>
                            <li class="nav-item">
                                <asp:HyperLink ID="SearchLink" runat="server" NavigateUrl="~/Search.aspx" CssClass="nav-link text-dark" Text="Search" />
                            </li>
                            <asp:PlaceHolder ID="AuthenticatedNavigation2" runat="server" Visible="false">
                                <li class="nav-item">
                                    <asp:HyperLink ID="ResaleLink" runat="server" NavigateUrl="~/Resale.aspx" CssClass="nav-link text-dark" Text="Resell my Books" />
                                </li>
                            </asp:PlaceHolder>
                            <li class="nav-item">
                                <asp:HyperLink ID="WishlistLink" runat="server" NavigateUrl="~/Wishlist.aspx" CssClass="nav-link text-dark" Text="Wish List" />
                            </li>
                            <li class="nav-item">
                                <asp:HyperLink ID="CartLink" runat="server" NavigateUrl="~/ShoppingCart.aspx" CssClass="nav-link text-dark" Text="Cart" />
                            </li>
                        </ul>
                    </div>

                    <!-- Login/Logout Section -->
                    <div class="navbar-nav">
                        <asp:PlaceHolder ID="AnonymousNavigation" runat="server">
                            <asp:HyperLink ID="LoginLink" runat="server" NavigateUrl="~/Login.aspx" CssClass="nav-link text-dark" Text="Login" />
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="AuthenticatedWelcome" runat="server" Visible="false">
                            <div class="hstack gap-2">
                                <asp:HyperLink ID="UserProfileLink" runat="server" NavigateUrl="~/Address.aspx" CssClass="nav-link text-dark me-2">
                                    Hello <asp:Literal ID="UserNameLiteral" runat="server" />!
                                </asp:HyperLink>
                                <asp:PlaceHolder ID="AdminPortalLink" runat="server" Visible="false">
                                    <asp:HyperLink ID="AdminLink" runat="server" NavigateUrl="~/Admin/Dashboard.aspx" CssClass="nav-link text-dark" Text="Admin Portal" />
                                    <div class="vr"></div>
                                </asp:PlaceHolder>
                                <asp:LinkButton ID="LogoutButton" runat="server" CssClass="nav-link text-dark" 
                                    OnClick="LogoutButton_Click" Text="Logout" />
                            </div>
                        </asp:PlaceHolder>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Main Content Container -->
        <div class="container">
            <!-- Error/Success Message Display -->
            <asp:Panel ID="ErrorPanel" runat="server" CssClass="alert alert-danger" Visible="false">
                <asp:Literal ID="ErrorMessage" runat="server" />
            </asp:Panel>
            
            <asp:Panel ID="SuccessPanel" runat="server" CssClass="alert alert-success" Visible="false">
                <asp:Literal ID="SuccessMessage" runat="server" />
            </asp:Panel>

            <main role="main" class="pb-3">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>

        <!-- Footer -->
        <footer>
            <div class="container">
                <div class="row">
                    <div class="col timing">
                        <h4>Our Address</h4>
                        <!-- sample data! -->
                        <h6>123 Any Street, Any Town, USA</h6>
                        <h6>Call: 555-0100</h6>
                        <h6>Email: staff@BobsUsedBooks.com</h6>
                    </div>

                    <div class="col timing">
                        <h4>Store Hours</h4>
                        <h6>Mon - Fri: 8am - 10pm</h6>
                        <h6>Saturday: 10am - 8pm</h6>
                        <h6>Sunday: 11am - 5pm</h6>
                    </div>

                    <div class="col navigation">
                        <h4>Navigation</h4>
                        <ul>
                            <li>
                                <asp:HyperLink ID="FooterHomeLink" runat="server" NavigateUrl="~/Default.aspx" CssClass="nav-link text-dark" Text="Home" />
                            </li>
                            <li>
                                <asp:HyperLink ID="FooterPrivacyLink" runat="server" NavigateUrl="~/Privacy.aspx" CssClass="nav-link text-dark" Text="Privacy" />
                            </li>
                            <li>
                                <asp:HyperLink ID="FooterOrdersLink" runat="server" NavigateUrl="~/Orders.aspx" CssClass="nav-link text-dark" Text="View Orders" />
                            </li>
                            <li>
                                <asp:HyperLink ID="FooterSearchLink" runat="server" NavigateUrl="~/Search.aspx" CssClass="nav-link text-dark" Text="Search Books" />
                            </li>
                            <li>
                                <asp:HyperLink ID="FooterCartLink" runat="server" NavigateUrl="~/ShoppingCart.aspx" CssClass="nav-link text-dark" Text="Cart" />
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="container">
                <p>&copy; <%= DateTime.Now.Year %> - Bob's Used Books</p>
            </div>
        </footer>

        <!-- JavaScript -->
        <script src="~/Scripts/jquery/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3" crossorigin="anonymous"></script>
        
        <asp:ContentPlaceHolder ID="ScriptContent" runat="server">
        </asp:ContentPlaceHolder>
    </form>
</body>
</html>